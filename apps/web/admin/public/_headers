# The support dashboard's own rules (step 4j, D641, D642), sent with every
# file by Cloudflare. As the app's (public/_headers there): no script, font
# or connection from anywhere but the dashboard's own address, and no script
# written into a page unless scripts/write-headers.ts lists its fingerprint.
# Nothing is kept by a browser (no-store), the dashboard is never shown in
# a search engine, and no other site can show it inside a frame.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'none'; manifest-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
