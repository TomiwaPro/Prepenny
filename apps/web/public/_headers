# Sent with every file by Cloudflare (D68). No script, font or connection
# from anywhere but PrePenny's own site (CLAUDE.md, D23).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# The app's own files have their contents in their names, so they never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The offline helper is checked for a new version on every visit.
/sw.js
  Cache-Control: no-cache

# Which version of PrePenny is live now (step 3e): never kept by a browser.
/version.json
  Cache-Control: no-store
