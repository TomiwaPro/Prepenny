{
  "name": "prepenny",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "test": "pnpm --recursive test && node --test scripts/*.test.ts",
    "lint": "biome check . && node scripts/check-engine-purity.ts && node scripts/check-voice.ts",
    "typecheck": "tsc --project tsconfig.json && pnpm --recursive typecheck",
    "format": "biome check --write .",
    "build": "pnpm --filter @prepenny/web build",
    "e2e": "pnpm --filter @prepenny/web e2e",
    "building-blocks": "node scripts/check-building-blocks.ts",
    "build:local": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH NEXT_PUBLIC_STATUS_PAGE_URL=https://stats.uptimerobot.com/prepenny-test pnpm --filter @prepenny/web build",
    "build:update-test": "rm -rf apps/web/e2e/.updating && PREPENNY_BUILD_NAME=update-test pnpm build:local && mkdir -p apps/web/e2e/.updating && mv apps/web/out apps/web/e2e/.updating/new"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
